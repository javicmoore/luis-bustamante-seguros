# ---------------------------------------------------------------------------
# Ejemplo de variables. NO pongas valores reales en este archivo.
# Copia a .env.local para desarrollo; en Vercel configúralas como variables
# privadas del proyecto (Settings → Environment Variables).
#
# Ninguna de estas variables lleva el prefijo VITE_: todas se leen solo en el
# servidor (funciones de /api). Una variable VITE_* termina en el navegador.
# ---------------------------------------------------------------------------

# Proveedor de notificación: "twilio" (por defecto) o "mock".
# "mock" solo funciona fuera de producción y responde como demostración.
LEAD_PROVIDER=mock
# Solo con LEAD_PROVIDER=mock: accepted | failed | uncertain | slow
MOCK_NOTIFY_OUTCOME=accepted

# --- Twilio WhatsApp (plantilla aprobada) ---------------------------------
# SID de la cuenta (AC...). Va en la URL de la API.
TWILIO_ACCOUNT_SID=
# API Key (SK...) y su secreto: credenciales para crear mensajes.
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Auth Token de la cuenta: Twilio firma los callbacks de estado con él.
TWILIO_AUTH_TOKEN=
# Remitente de WhatsApp habilitado en Twilio, formato E.164 (+1..., +52...).
TWILIO_WHATSAPP_FROM=
# Content SID (HX...) de la plantilla APROBADA por WhatsApp.
TWILIO_CONTENT_SID=
# WhatsApp de Luis que recibe los avisos (E.164). Debe haber aceptado
# recibir notificaciones del remitente. Distinto de TWILIO_WHATSAPP_FROM.
LEAD_NOTIFICATION_TO=

# --- Almacenamiento compartido (Upstash Redis vía Vercel Marketplace) -------
# La integración de Vercel puede crear KV_REST_API_URL / KV_REST_API_TOKEN;
# también se aceptan esos nombres.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secreto para seudonimizar IP/teléfono en límites de uso (32+ caracteres).
# PowerShell:  -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
LEAD_HASH_SECRET=

# Días que se conserva el registro mínimo de cada solicitud (1-90).
LEAD_RETENTION_DAYS=30
# Tope global de solicitudes por día (protege costos ante abuso).
LEAD_DAILY_CAP=50

# --- Dominio -----------------------------------------------------------------
# Solo cuando el dominio definitivo esté confirmado (https://...).
# Activa canonical, og:url, og:image absoluta, sitemap y la URL del callback.
SITE_URL=
# Orígenes extra permitidos para POST /api/leads, separados por coma.
ALLOWED_ORIGINS=

# --- Demostración ------------------------------------------------------------
# "demo" publica una versión de revisión: formulario desactivado, aviso visible y noindex.
# Eliminarla para el lanzamiento real. Ver docs/DEMO.md.
SITE_MODE=

# --- Revisión de lanzamiento ---------------------------------------------------
# En despliegues de producción de Vercel el build se detiene si hay pendientes
# bloqueantes. "warn" lo convierte en aviso: úsalo solo como decisión explícita.
RELEASE_CHECK=
